{
  "name": "@ozan.e/jikz",
  "version": "0.8.0",
  "description": "TikZ-inspired coordinate and drawing library for JavaScript/TypeScript",
  "type": "module",
  "main": "./dist/jikz.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/jikz.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vitepress dev docs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "build": "npm run typecheck && vite build && node scripts/postbuild-dts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:api": "typedoc",
    "docs:cookbook": "vite-node scripts/build-cookbook.ts",
    "check:examples": "vite-node scripts/check-examples.ts",
    "preview:examples": "vite-node scripts/preview-examples.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "npm run lint && npm run test && npm run build && npm run check:pkg",
    "check:pkg": "publint && attw --pack .",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "peerDependencies": {
    "katex": ">=0.16.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "katex": "^0.16.11",
    "mathjax-full": "^3.2.1",
    "publint": "^0.3.24",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.14",
    "vite-plugin-dts": "^4.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "tikz",
    "svg",
    "graphics",
    "geometry",
    "coordinates",
    "drawing"
  ],
  "author": "ozan.erdemir <erdemirozan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binboavetonik/jikz.git"
  },
  "homepage": "https://binboavetonik.github.io/jikz/",
  "bugs": "https://github.com/binboavetonik/jikz/issues",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
