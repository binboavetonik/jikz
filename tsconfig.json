{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "jikz": [
        "./src/index.ts"
      ],
      "jikz/circuits": [
        "./src/ext/circuits/index.ts"
      ],
      "jikz/gates": [
        "./src/ext/gates/index.ts"
      ],
      "jikz/dataviz": [
        "./src/ext/dataviz/index.ts"
      ],
      "jikz/petri": [
        "./src/ext/petri/index.ts"
      ],
      "jikz/layout": [
        "./src/layout/index.ts"
      ],
      "jikz/styles": [
        "./src/render/presets.ts"
      ]
    },
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src",
    "examples"
  ]
}
