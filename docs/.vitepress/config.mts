  // The site root is the live gallery (index.md). docs/README.md — the
  // GitHub-readable documentation map — is served at /overview/, and the
  // cookbook's README.md as its directory index, instead of README.html.
  rewrites: {
    'README.md': 'overview.md',
    'cookbook/README.md': 'cookbook/index.md',
