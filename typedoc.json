{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs/public/api",
  "name": "jikz",
  "readme": "docs/README.md",
  "disableSources": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "navigation": {
    "includeCategories": true
  },
  "commentStyle": "jsdoc",
  "visibilityFilters": {
    "protected": false,
    "inherited": true
  }
}
