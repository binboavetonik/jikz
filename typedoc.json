{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs/public/api",
  "name": "jikz",
  "readme": "docs/api-readme.md",
  "disableSources": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "navigation": {
    "includeCategories": true
  },
  "commentStyle": "jsdoc",
  "visibilityFilters": {
    "protected": false,
    "inherited": true
  },
  "navigationLinks": {
    "Documentation": "https://binboavetonik.github.io/jikz/",
    "Cookbook": "https://binboavetonik.github.io/jikz/cookbook/",
    "GitHub": "https://github.com/binboavetonik/jikz"
  }
}
