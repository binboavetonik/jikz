exports[`snapshot: KaTeX math > embeds KaTeX HTML in a foreignObject (stubbed katex, no DOM) 1`] = `"<svg height="60" viewBox="0 0 120 60" width="120" xmlns="http://www.w3.org/2000/svg"><foreignObject height="50" overflow="visible" width="200" x="-40" y="5"><div xmlns="http://www.w3.org/1999/xhtml" style="display:flex;justify-content:center;align-items:center;width:100%;height:100%;font-size:14px"><span class="katex-stub" data-display="false">x^2</span></div></foreignObject></svg>"`;

exports[`snapshot: KaTeX math > falls back to plain text when katex is absent 1`] = `"<svg height="60" viewBox="0 0 120 60" width="120" xmlns="http://www.w3.org/2000/svg"><text dominant-baseline="middle" fill="#000" font-family="serif" font-size="14" font-style="italic" text-anchor="middle" x="60" y="30">$x^2$</text></svg>"`;

