"125" y="150">C</text></g><g><path d="M 72 60 L 165 60" fill="none" fill-opacity="1" marker-end="url(#arrow-stealth-000000)" opacity="1" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="1" stroke-width="1"/><text dominant-baseline="middle" fill="#000000" font-family="sans-serif" font-size="12" text-anchor="middle" x="118.5" y="55">ab</text></g><g><path d="M 50 82 L 90 150" fill="none" fill-opacity="1" marker-end="url(#arrow-latex-000000)" opacity="1" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="1" stroke-width="1"/></g><g><path d="M 160 150 L 200 80" fill="none" fill-opacity="1" marker-end="url(#arrow-to-2563eb)" opacity="1" stroke="#2563eb" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="1" stroke-width="1"/></g></svg>"`;

exports[`snapshot: gradient and shadow > renders a linear-gradient rect and a shadowed circle 1`] = `"<svg height="100" viewBox="0 0 220 100" width="220" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="jikz-gradient-linear-a45-0-0ea5e9-1-a855f7" x1="14.64%" x2="85.36%" y1="85.36%" y2="14.64%"><stop offset="0.0%" stop-color="#0ea5e9"/><stop offset="100.0%" stop-color="#a855f7"/></linearGradient><filter height="200%" id="jikz-shadow-3-3-4-rgba00003" width="200%" x="-50%" y="-50%"><feGaussianBlur in="SourceAlpha" result="blur" stdDeviation="4"/><feOffset dx="3" dy="3" in="blur" result="offsetBlur"/><feFlood flood-color="rgb(0,0,0)" flood-opacity="0.3" result="color"/><feComposite in="color" in2="offsetBlur" operator="in" result="shadow"/><feMerge><feMergeNode in="shadow"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs><rect fill="url(#jikz-gradient-linear-a45-0-0ea5e9-1-a855f7)" fill-opacity="1" height="60" opacity="1" stroke="#111827" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="1" stroke-width="1" width="90" x="10" y="20"/><circle cx="170" cy="50" fill="#fde047" fill-opacity="1" filter="url(#jikz-shadow-3-3-4-rgba00003)" opacity="1" r="30" stroke="#ca8a04" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="1" stroke-width="1"/></svg>"`;

