exports[`examples > node-auto-size 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="300" height="170" viewBox="0 0 300 170"><g><path d="M 114.094 37.25 L 185.906 37.25 L 185.906 62.75 L 114.094 62.75 Z" stroke="#334155" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="150" y="50" font-family="sans-serif" font-size="14" font-weight="normal" fill="#334155">auto sized</text></g><g><path d="M 100.871000 120 A 49.129 49.129 0 1 0 199.129 120 A 49.129 49.129 0 1 0 100.871000 120" stroke="#7c3aed" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#ede9fe" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="150" y="120" font-family="sans-serif" font-size="14" font-weight="normal" fill="#7c3aed">and circles too</text></g></svg>"`;

exports[`examples > node-labels 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="430" height="180" viewBox="0 0 430 180"><g><path d="M 60 90 A 30 30 0 1 0 120 90 A 30 30 0 1 0 60 90" stroke="#2563eb" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="90" y="90" font-family="sans-serif" font-size="14" font-weight="normal" fill="#2563eb">A</text></g><text text-anchor="middle" dominant-baseline="middle" x="90" y="48.5" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\alpha$</text><text x="119.977131" y="119.977131" font-family="sans-serif" font-size="9" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">rim</text><g><path d="M 200 60 L 310 60 L 310 120 L 200 120 Z" stroke="#16a34a" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dcfce7" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="255" y="90" font-family="sans-serif" font-size="14" font-weight="normal" fill="#16a34a">B</text></g><text x="183.403646" y="43.403646" font-family="sans-serif" font-size="9" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">nw alias</text><text x="255" y="46.375" font-family="sans-serif" font-size="9" font-weight="normal" fill="#dc2626" text-anchor="middle" dominant-baseline="middle">270° = north</text><text x="352.264" y="90" font-family="sans-serif" font-size="9" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">distance: 18</text></svg>"`;

