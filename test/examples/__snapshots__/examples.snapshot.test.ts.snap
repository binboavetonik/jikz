ill-opacity="1" opacity="1"></path></g><text x="542" y="180" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">cylinder</text><g><path d="M 47 224 L 87 224 L 87 214 L 109 236 L 87 258 L 87 248 L 47 248 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="272" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">single arrow</text><g><path d="M 163 236 L 185 214 L 185 224 L 203 224 L 203 214 L 225 236 L 203 258 L 203 248 L 185 248 L 185 258 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="272" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">double arrow</text><g><path d="M 279 214 L 341 214 L 341 238 L 317.5 238 L 310 258 L 302.5 238 L 279 238 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="272" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">callout</text><g><path d="M 435.58175 215.0719 A 7.445471 7.445471 0 0 1 446.457952 225.451659 A 7.445471 7.445471 0 0 1 449.017283 236 A 7.445471 7.445471 0 0 1 446.457952 246.548341 A 7.445471 7.445471 0 0 1 435.58175 256.9281 A 7.445471 7.445471 0 0 1 416.41825 256.9281 A 7.445471 7.445471 0 0 1 405.542048 246.548341 A 7.445471 7.445471 0 0 1 402.982717 236 A 7.445471 7.445471 0 0 1 405.542048 225.451659 A 7.445471 7.445471 0 0 1 416.41825 215.0719 A 7.445471 7.445471 0 0 1 435.58175 215.0719 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="272.845471" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">cloud</text><g><path d="M 511 236 L 533 214 L 551 214 L 573 236 L 551 258 L 533 258 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="272" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">signal</text><g><path d="M 47 306 Q 78 314 109 306 L 109 350 Q 78 342 47 350 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="364" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">tape</text><g><path d="M 194 306 L 198.789763 317.538378 L 212.221343 310.201626 L 206.539763 321.534362 L 223.482752 321.201626 L 209.5 328 L 223.482752 334.798374 L 206.539763 334.465638 L 212.221343 345.798374 L 198.789763 338.461622 L 194 350 L 189.210237 338.461622 L 175.778657 345.798374 L 181.460237 334.465638 L 164.517248 334.798374 L 178.5 328 L 164.517248 321.201626 L 181.460237 321.534362 L 175.778657 310.201626 L 189.210237 317.538378 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="364" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">starburst</text><g><path d="M 341 343.5 A 31 31 0 0 0 279 343.5 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="357.5" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">semicircle</text><g><path d="M 426 306 L 457 321.4 L 426 350 L 395 321.4 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="364" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">kite</text><g><path d="M 542 306 L 573 350 L 542 336.8 L 511 350 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="364" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">dart</text><g><path d="M 65.298294 420 L 78 398 A 25.403412 25.403412 0 0 1 78 442 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="456" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">circular sector</text><g><path d="M 171 398 L 217 398 A 8 8 0 0 1 225 406 L 225 434 A 8 8 0 0 1 217 442 L 171 442 A 8 8 0 0 1 163 434 L 163 406 A 8 8 0 0 1 171 398 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="456" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">rounded rectangle</text><g><path d="M 287 398 L 333 398 L 341 406 L 341 434 L 333 442 L 287 442 L 279 434 L 279 406 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="456" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">chamfered rectangle</text><g><path d="M 395 398 L 457 442 M 457 398 L 395 442" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="456" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">cross out</text><g><path d="M 511 420 L 573 420" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="456" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">strike out</text><g><path d="M 109 512 A 31 31 0 1 1 47 512 A 31 31 0 1 1 109 512 M 56.07969 533.92031 L 99.92031 490.07969" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="557" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">forbidden sign</text><g><path d="M 210.464466 508.464466 A 20 20 0 1 1 170.464466 508.464466 A 20 20 0 1 1 210.464466 508.464466 M 202.485281 524.727922 L 212.384776 534.627417 L 216.627417 530.384776 L 206.727922 520.485281 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="546.506097" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">magnifying glass</text><g><path d="M 316.973721 531.052559 A 22 22 0 1 1 325.026279 523 L 330.526279 523 Q 336.026279 523 336.026279 528.5" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="548" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">magnetic tape</text><g><path d="M 434.02339 508.676295 A 31 9.5 0 1 1 417.97661 508.676295 L 426 534 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="548" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">ellipse callout</text><g><path d="M 552.76674 494.960173 A 6.89 6.89 0 0 1 562.491973 507.383187 A 6.89 6.89 0 0 1 562.491973 519.430746 A 6.89 6.89 0 0 1 552.76674 531.85376 A 6.89 6.89 0 0 1 531.23326 531.85376 A 6.89 6.89 0 0 1 521.508027 519.430746 A 6.89 6.89 0 0 1 521.508027 507.383187 A 6.89 6.89 0 0 1 531.23326 494.960173 A 6.89 6.89 0 0 1 552.76674 494.960173 Z M 527.320899 495.282866 A 3.445 3.445 0 1 1 520.430899 495.282866 A 3.445 3.445 0 1 1 527.320899 495.282866 M 525.435983 493.84295 A 3 3 0 1 1 519.435983 493.84295 A 3 3 0 1 1 525.435983 493.84295 M 523.996067 492.403033 A 3 3 0 1 1 517.996067 492.403033 A 3 3 0 1 1 523.996067 492.403033" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="548.596967" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">cloud callout</text><g><path d="M 47 582 L 109 582 L 109 626 L 47 626 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="640" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">arrow box</text><g><path d="M 225 604 A 31 31 0 1 1 163 604 A 31 31 0 1 1 225 604 M 163 604 L 225 604" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="649" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">circle split</text><g><path d="M 279 582 L 341 582 L 341 626 L 279 626 Z M 279 604 L 341 604" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="640" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">rectangle split</text></svg>"`;

exports[`examples > snell 1`] = `"<input type="range" min="5" max="80" style="width: 100%;"><div><svg xmlns="http://www.w3.org/2000/svg" width="420" height="230" viewBox="0 0 420 230"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-dc2626" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#dc2626"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-7c3aed" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#7c3aed"></path></marker></defs><rect width="380" height="80" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="0.4" opacity="1" x="20" y="30"></rect><rect width="380" height="100" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#0ea5e9" fill-opacity="0.18" opacity="1" x="20" y="110"></rect><line x1="20" y1="110" x2="400" y2="110" stroke="#334155" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><line x1="210" y1="30" x2="210" y2="210" stroke="#94a3b8" stroke-width="1" stroke-opacity="1" stroke-dasharray="3 3" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><g><path d="M 110.414222 26.437611 L 210 110" stroke="#dc2626" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-dc2626)"></path></g><g><path d="M 210 110 L 155.28254 187.65951" stroke="#7c3aed" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-7c3aed)"></path></g><path d="M 179.358222 84.288496 A 40 40 0 0 1 210 70" stroke="#dc2626" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><path d="M 210 140 A 30 30 0 0 1 192.720802 134.524056" stroke="#7c3aed" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="186.333377" y="59.246764" font-family="serif" font-size="12" font-style="italic" fill="#000000">$\\theta_1$</text><text text-anchor="middle" dominant-baseline="middle" x="196.103299" y="153.850675" font-family="serif" font-size="12" font-style="italic" fill="#000000">$\\theta_2$</text><text x="368" y="60" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">air</text><text x="356" y="195" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">water</text><text x="24" y="24" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="start" dominant-baseline="middle">incidence: 50°  →  refraction: 35.2°</text></svg></div>"`;

