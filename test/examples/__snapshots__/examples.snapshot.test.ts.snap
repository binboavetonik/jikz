exports[`examples > styled-badges 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="525.183" height="192" viewBox="23.216 21.25 525.183 192"><defs><filter id="jikz-shadow-2-3-5-7c3aed55" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur in="SourceAlpha" stdDeviation="5" result="blur"></feGaussianBlur><feOffset in="blur" dx="2" dy="3" result="offsetBlur"></feOffset><feFlood flood-color="#7c3aed55" flood-opacity="1" result="color"></feFlood><feComposite in="color" in2="offsetBlur" operator="in" result="shadow"></feComposite><feMerge><feMergeNode in="shadow"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter></defs><g><path d="M 41.216 47.25 L 78.784 47.25 L 78.784 72.75 L 41.216 72.75 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="60" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#334155">plain</text></g><g><path d="M 162.317 47.25 L 197.683 47.25 A 12 12 0 0 1 209.683 59.25 L 209.683 60.75 A 12 12 0 0 1 197.683 72.75 L 162.317 72.75 A 12 12 0 0 1 150.317 60.75 L 150.317 59.25 A 12 12 0 0 1 162.317 47.25 Z" stroke="#2563eb" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="180" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#2563eb">rounded</text></g><g><path d="M 250.256 39.25 L 349.744 39.25 L 349.744 80.75 L 250.256 80.75 Z" stroke="#16a34a" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dcfce7" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="300" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#16a34a">innerSep 12</text></g><g><path d="M 402.094 47.2