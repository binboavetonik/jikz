acity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="272.845471" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">cloud</text><g><path d="M 511 236 L 533 214 L 551 214 L 573 236 L 551 258 L 533 258 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="272" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">signal</text><g><path d="M 47 306 Q 78 314 109 306 L 109 350 Q 78 342 47 350 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="364" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">tape</text><g><path d="M 194 306 L 198.789763 317.538378 L 212.221343 310.201626 L 206.539763 321.534362 L 223.482752 321.201626 L 209.5 328 L 223.482752 334.798374 L 206.539763 334.465638 L 212.221343 345.798374 L 198.789763 338.461622 L 194 350 L 189.210237 338.461622 L 175.778657 345.798374 L 181.460237 334.465638 L 164.517248 334.798374 L 178.5 328 L 164.517248 321.201626 L 181.460237 321.534362 L 175.778657 310.201626 L 189.210237 317.538378 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="364" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">starburst</text><g><path d="M 341 343.5 A 31 31 0 0 0 279 343.5 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opaci