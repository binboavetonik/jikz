exports[`examples > scope-groups 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="354" height="122" viewBox="-2 8 354 122"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-2563eb" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#2563eb"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-16a34a" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#16a34a"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-c2410c" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#c2410c"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-94a3b8" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#94a3b8"></path></marker></defs><g transform="matrix(1 0 0 1 10 20)"><rect width="90" height="54" stroke="#2563eb" stroke-width="1.6" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f8fafc" fill-opacity="1" opacity="1" x="0" y="0"></rect><g><path d="M 12 27 A 10 10 0 1 0 32 27 A 10 10 0 1 0 12 27" stroke="#2563eb" stroke-width="1.6" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path></g><g><path d="M 58 27 A 10 10 0 1 0 78 27 A 10 10 0 1 0 58 27" stroke="#2563eb" stroke-width="1.6" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path></g><g><path d="M 32 27 L 58 27" stroke="#2563eb" stroke-width="1.6" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-2563eb)"></path></g><text x="45" y="12" font-family="sans-serif" font-size="10" font-weight="normal" fill="#2563eb" text-anchor="middle" dominant-baseline="middle">ingest</text></g><g transform="matrix(1 0 0 1 130 20)"><rect width="90" height