exports[`examples > snell 1`] = `"<input type="range" min="5" max="80" style="width: 100%;"><div><svg xmlns="http://www.w3.org/2000/svg" width="420" height="230" viewBox="0 0 420 230"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-dc2626" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#dc2626"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-7c3aed" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#7c3aed"></path></marker></defs><rect width="380" height="80" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="0.4" opacity="1" x="20" y="30"></rect><rect width="380" height="100" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#0ea5e9" fill-opacity="0.18" opacity="1" x="20" y="110"></rect><line x1="20" y1="110" x2="400" y2="110" stroke="#334155" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><line x1="210" y1="30" x2="210" y2="210" stroke="#94a3b8" stroke-width="1" stroke-opacity="1" stroke-dasharray="6 4" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><g><path d="M 110.41422239453286 26.43761074074989 L 210 110" stroke="#dc2626" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-dc2626)"></path></g><g><path d="M 210 110 L 155.28253977721585 187.65951034334452" stroke="#7c3aed" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-7c3aed)"></path></g><path d="M 179.35822227524088 84.28849561253843 A 40 40 0 0 1 210 70" stroke="#dc2626" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><path d="M 210 140 A 30 30 0 0 1 192.72080203491026 134.52405589789828" stroke="#7c3aed" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="186.3333773425208" y="59.24676392594762" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\theta_1$</text><text text-anchor="middle" dominant-baseline="middle" x="196.10329912050628" y="153.85067507651254" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\theta_2$</text><text x="368" y="60" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">air</text><text x="356" y="195" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">water</text><text x="24" y="24" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="start" dominant-baseline="middle">incidence: 50°  →  refraction: 35.2°</text></svg></div>"`;

exports[`examples > styling 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="360" height="200" viewBox="0 0 360 200"><defs><linearGradient id="jikz-gradient-linear-a45-0-0ea5e9-1-a855f7" x1="14.64%" y1="85.36%" x2="85.36%" y2="14.64%"><stop offset="0.0%" stop-color="#0ea5e9"></stop><stop offset="100.0%" stop-color="#a855f7"></stop></linearGradient><filter id="jikz-shadow-3-3-4-000" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur in="SourceAlpha" stdDeviation="4" result="blur"></feGaussianBlur><feOffset in="blur" dx="3" dy="3" result="offsetBlur"></feOffset><feFlood flood-color="#000" flood-opacity="1" result="color"></feFlood><feComposite in="color" in2="offsetBlur" operator="in" result="shadow"></feComposite><feMerge><feMergeNode in="shadow"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter></defs><rect width="140" height="120" stroke="#111827" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="url(#jikz-gradient-linear-a45-0-0ea5e9-1-a855f7)" fill-opacity="1" opacity="1" x="30" y="40"></rect><circle r="55" stroke="#ca8a04" stroke-width="2" stroke-opacity="1" stroke-dasharray="6 4" stroke-linecap="round" stroke-linejoin="round" fill="#fde047" fill-opacity="1" opacity="1" filter="url(#jikz-shadow-3-3-4-000)" cx="260" cy="100"></circle></svg>"`;

exports[`examples > tcp-states 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="500" height="320" viewBox="0 0 500 320"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-64748b" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#64748b"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-2563eb" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#2563eb"></path></marker></defs><g><path d="M 52 110 A 38 38 0 1 0 128 110 A 38 38 0 1 0 52 110" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="90" y="110" font-family="sans-serif" font-size="11" font-weight="normal" fill="#334155">CLOSED</text></g><g><path d="M 207 60 A 43 43 0 1 0 293 60 A 43 43 0 1 0 207 60" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="250" y="60" font-family="sans-serif" font-size="11" font-weight="normal" fill="#334155">SYN SENT</text></g><g><path d="M 354 120 A 56 56 0 1 0 466 120 A 56 56 0 1 0 354 120" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="410" y="120" font-family="sans-serif" font-size="10" font-weight="normal" fill="#334155">ESTABLISHED</text></g><g><path d="M 207 200 A 43 43 0 1 0 293 200 A 43 43 0 1 0 207 200" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="250" y="200" font-family="sans-serif" font-size="11" font-weight="normal" fill="#334155">FIN WAIT</text></g><g><path d="M 54 260 A 36 36 0 1 0 126 260 A 36 36 0 1 0 54 260" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="90" y="260" font-family="sans-serif" font-size="11" font-weight="normal" fill="#334155">LISTEN</text></g><g><path d="M 126.27023916533113 98.66555026083401 L 208.9573609444937 72.82582470484572" stroke="#64748b" stroke-width="1.2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-64748b)"></path><text text-anchor="middle" dominant-baseline="middle" x="166.1224250892323" y="80.97328759266482" font-family="sans-serif" font-size="12" fill="#64748b">send SYN</text></g><g><path d="M 290.2621546354689 75.09830798830085 L 357.5655660561335 100.33708727105008" stroke="#64748b" stroke-width="1.2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-64748b)"></path><text text-anchor="middle" dominant-baseline="middle" x="325.6694775537436" y="83.03605174183039" font-family="sans-serif" font-size="12" fill="#64748b">SYN+ACK, ACK</text></g><g><path d="M 359.9120773040047 145.04396134799762 L 288.4603692129964 180.76981539350183" stroke="#64748b" stroke-width="1.2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-64748b)"></path><text text-anchor="middle" dominant-baseline="middle" x="326.4222912360003" y="167.3790243257493" font-family="sans-serif" font-size="12" fill="#64748b">close / FIN</text></g><g><path d="M 212.52225190364436 178.91876669579997 L 123.11987041073287 128.62992710603726" stroke="#64748b" stroke-width="1.2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" 