exports[`examples > snell 1`] = `"<input type="range" min="5" max="80" style="width: 100%;"><div><svg xmlns="http://www.w3.org/2000/svg" width="420" height="230" viewBox="0 0 420 230"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-dc2626" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#dc2626"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-7c3aed" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#7c3aed"></path></marker></defs><rect width="380" height="80" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="0.4" opacity="1" x="20" y="30"></rect><rect width="380" height="100" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#0ea5e9" fill-opacity="0.18" opacity="1" x="20" y="110"></rect><line x1="20" y1="110" x2="400" y2="110" stroke="#334155" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><line x1="210" y1="30" x2="210" y2="210" stroke="#94a3b8" stroke-width="1" stroke-opacity="1" stroke-dasharray="3 3" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><g><path d="M 110.414222 26.437611 L 210 110" stroke="#dc2626" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-dc2626)"></path></g><g><path d="M 210 110 L 155.282540 187.659510" stroke="#7c3aed" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-7c3aed)"></path></g><path d="M 179.358222 84.288496 A 40 40 0 0 1 210 70" stroke="#dc2626" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><path d="M 210 140 A 30 30 0 0 1 192.720802 134.524056" stroke="#7c3aed" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="186.333377" y="59.246764" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\theta_1$</text><text text-anchor="middle" dominant-baseline="middle" x="196.103299" y="153.850675" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\theta_2$</text><text x="368" y="60" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">air</text><text x="356" y="195" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">water</text><text x="24" y="24" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="start" dominant-baseline="middle">incidence: 50°  →  refraction: 35.2°</text></svg></div>"`;

