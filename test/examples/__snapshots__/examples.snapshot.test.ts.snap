exports[`examples > plate-diagram 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="238" height="208" viewBox="24 28 238 208"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-64748b" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#64748b"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-94a3b8" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#94a3b8"></path></marker></defs><g><path d="M 68 80 A 22 22 0 1 0 112 80 A 22 22 0 1 0 68 80" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#ffffff" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="90" y="80" font-family="serif" font-size="14" font-style="italic" fill="#000">$z_i$</text></g><g><path d="M 188 80 A 22 22 0 1 0 232 80 A 22 22 0 1 0 188 80" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#cbd5e1" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="210" y="80" font-family="serif" font-size="14" font-style="italic" fill="#000">$x_i$</text></g><g><path d="M 36 200 A 24 24 0 1 0 84 200 A 24 24 0 1 0 36 200" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#ffffff" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="60" y="200" font-family="serif" font-size="14" font-style="italic" fill="#000">$\\theta$</text></g><g><path d="M 65.82085500087197 176.71657999651202 L 84.66421624920066 101.3431350031973" stroke="#64748b" stroke-width="1.2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-64748b)"></path></g><g><path d="M 112 80 L 188 80" stroke="#64748b" stroke-width="1.2" stroke-opacity="1" st