exports[`examples > fill-patterns 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="480" height="210" viewBox="0 0 480 210"><defs><pattern id="jikz-pattern-north-east-lines" patternUnits="userSpaceOnUse" width="10" height="10"><line x1="0" y1="10" x2="10" y2="0" stroke="#000000" stroke-width="0.8"></line><line x1="-2" y1="2" x2="2" y2="-2" stroke="#000000" stroke-width="0.8"></line><line x1="8" y1="12" x2="12" y2="8" stroke="#000000" stroke-width="0.8"></line></pattern><pattern id="jikz-pattern-crosshatch" patternUnits="userSpaceOnUse" width="10" height="10"><line x1="0" y1="10" x2="10" y2="0" stroke="#000000" stroke-width="0.6"></line><line x1="0" y1="0" x2="10" y2="10" stroke="#000000" stroke-width="0.6"></line><line x1="-2" y1="2" x2="2" y2="-2" stroke="#000000" stroke-width="0.6"></line><line x1="8" y1="12" x2="12" y2="8" stroke="#000000" stroke-width="0.6"></line><line x1="-2" y1="8" x2="2" y2="12" stroke="#000000" stroke-width="0.6"></line><line x1="8" y1="-2" x2="12" y2="2" stroke="#000000" stroke-width="0.6"></line></pattern><pattern id="jikz-pattern-grid" patternUnits="userSpaceOnUse" width="10" height="10"><line x1="0" y1="5" x2="10" y2="5" stroke="#000000" stroke-width="0.6"></line><line x1="5" y1="0" x2="5" y2="10" stroke="#000000" stroke-width="0.6"></line></pattern><pattern id="jikz-pattern-dots" patternUnits="userSpaceOnUse" width="10" height="10"><circle cx="5" cy="5" r="1.5" fill="#000000"></circle></pattern><pattern id="jikz-pattern-bricks" patternUnits="userSpaceOnUse" width="20" height="16"><line x1="0" y1="0" x2="20" y2="0" stroke="#000000" stroke-width="0.8"></line><line x1="0" y1="8" x2="20" y2="8" stroke="#000000" stroke-width="0.8"></line><line x1="0" y1="16" x2="20" y2="16" stroke="#000000" stroke-width="0.8"></line><line x1="10" y1="0" x2="10" y2="8" stroke="#000000" stroke-width="0.8"></line><line x1="0" y1="8" x2="0" y2="16" stroke="#000000" stroke-width="0.8"></line><line x1="20" y1="8" x2="20" y2="16" stroke="#000000" stroke-width