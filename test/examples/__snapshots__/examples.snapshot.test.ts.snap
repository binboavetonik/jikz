exports[`examples > shape-gallery 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="620" height="684" viewBox="0 0 620 684"><g><path d="M 47 30 L 109 30 L 109 74 L 47 74 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="88" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">rectangle</text><g><path d="M 163 52 A 31 31 0 1 0 225 52 A 31 31 0 1 0 163 52" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="97" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">circle</text><g><path d="M 341 52 A 31 22 0 0 1 279 52 A 31 22 0 0 1 341 52 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="88" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">ellipse</text><g><path d="M 426 30 L 457 52 L 426 74 L 395 52 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="88" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">diamond</text><g><path d="M 523.4 30 L 560.6 30 L 573 74 L 511 74 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="88" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">trapezium</text><g><