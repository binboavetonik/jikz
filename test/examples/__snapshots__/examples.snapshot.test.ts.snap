exports[`examples > animation 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="400" height="200" viewBox="0 0 400 200"><g transform="matrix(1 0 0 1 200 100)"><circle r="6" stroke="#0ea5e9" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" cx="0" cy="0"><animateTransform attributeName="transform" dur="2.1s" from="1" to="12" repeatCount="indefinite" begin="0s" type="scale"></animateTransform><animate attributeName="opacity" dur="2.1s" values="0.9;0" repeatCount="indefinite" begin="0s"></animate></circle></g><g transform="matrix(1 0 0 1 200 100)"><circle r="6" stroke="#0ea5e9" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" cx="0" cy="0"><animateTransform attributeName="transform" dur="2.1s" from="1" to="12" repeatCount="indefinite" begin="0.7s" type="scale"></animateTransform><animate attributeName="opacity" dur="2.1s" values="0.9;0" repeatCount="indefinite" begin="0.7s"></animate></circle></g><g transform="matrix(1 0 0 1 200 100)"><circle r="6" stroke="#0ea5e9" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" cx="0" cy="0"><animateTransform attributeName="transform" dur="2.1s" from="1" to="12" repeatCount="indefinite" begin="1.4s" type="scale"></animateTransform><animate attributeName="opacity" dur="2.1s" values="0.9;0" repeatCount="indefinite" begin="1.4s"></animate></circle></g><line x1="200" y1="100" x2="200" y2="20" stroke="#0369a1" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"><animateTransform attributeName="transform" dur="4.2s" from="0 200 100" to="360 200 100" repeatCount="indefinite" type="rotate"></animateTransform></line><circle r="6" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#0369a1" fill-opacity="1" opacity="1" cx="200" cy="100"></circle></svg>"`;

