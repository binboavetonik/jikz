exports[`examples > katex-math 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="370" height="150" viewBox="0 0 370 150"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-000000" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#000000"></path></marker></defs><g><path d="M 45 70 A 45 45 0 1 0 135 70 A 45 45 0 1 0 45 70" stroke="#2563eb" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="90" y="70" font-family="serif" font-size="14" font-style="italic" fill="#2563eb">$e^{i\\pi}+1=0$</text></g><g><path d="M 205 40 L 335 40 L 335 100 L 205 100 Z" stroke="#7c3aed" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#ede9fe" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="270" y="70" font-family="serif" font-size="14" font-style="italic" fill="#7c3aed">$\\int_0^1 x^2\\,dx$</text></g><g><path d="M 135 70 L 205 70" stroke="#000000" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-000000)"></path><text text-anchor="middle" dominant-baseline="middle" x="170" y="65" font-family="serif" font-size="14" font-style="italic" fill="#000000">$\\Rightarrow$</text></g></svg>"`;

