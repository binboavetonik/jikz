523 Q 336.026279 523 336.026279 528.5" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="548" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">magnetic tape</text><g><path d="M 434.023390 508.676295 A 31 9.5 0 1 1 417.976610 508.676295 L 426 534 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="426" y="548" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">ellipse callout</text><g><path d="M 552.766740 494.960173 A 6.890000 6.890000 0 0 1 562.491973 507.383187 A 6.890000 6.890000 0 0 1 562.491973 519.430746 A 6.890000 6.890000 0 0 1 552.766740 531.853760 A 6.890000 6.890000 0 0 1 531.233260 531.853760 A 6.890000 6.890000 0 0 1 521.508027 519.430746 A 6.890000 6.890000 0 0 1 521.508027 507.383187 A 6.890000 6.890000 0 0 1 531.233260 494.960173 A 6.890000 6.890000 0 0 1 552.766740 494.960173 Z M 527.320899 495.282866 A 3.445000 3.445000 0 1 1 520.430899 495.282866 A 3.445000 3.445000 0 1 1 527.320899 495.282866 M 525.435983 493.842950 A 3 3 0 1 1 519.435983 493.842950 A 3 3 0 1 1 525.435983 493.842950 M 523.996067 492.403033 A 3 3 0 1 1 517.996067 492.403033 A 3 3 0 1 1 523.996067 492.403033" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="542" y="548.596967" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">cloud callout</text><g><path d="M 47 582 L 109 582 L 109 626 L 47 626 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="78" y="640" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">arrow box</text><g><path d="M 225 604 A 31 31 0 1 1 163 604 A 31 31 0 1 1 225 604 M 163 604 L 225 604" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="194" y="649" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">circle split</text><g><path d="M 279 582 L 341 582 L 341 626 L 279 626 Z M 279 604 L 341 604" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#e0e7ff" fill-opacity="1" opacity="1"></path></g><text x="310" y="640" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="middle" dominant-baseline="middle">rectangle split</text></svg>"`;

exports[`examples > snell 1`] = `"<input type="range" min="5" max="80" style="width: 100%;"><div><svg xmlns="http://www.w3.org/2000/svg" width="420" height="230" viewBox="0 0 420 230"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-dc2626" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#dc2626"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-7c3aed" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#7c3aed"></path></marker></defs><rect width="380" height="80" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="0.4" opacity="1" x="20" y="30"></rect><rect width="380" height="100" stroke="none" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#0ea5e9" fill-opacity="0.18" opacity="1" x="20" y="110"></rect><line x1="20" y1="110" x2="400" y2="110" stroke="#334155" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><line x1="210" y1="30" x2="210" y2="210" stroke="#94a3b8" stroke-width="1" stroke-opacity="1" stroke-dasharray="3 3" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></line><g><path d="M 110.414222 26.437611 L 210 110" stroke="#dc2626" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-dc2626)"></path></g><g><path d="M 210 110 L 155.282540 187.659510" stroke="#7c3aed" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" marker-end="url(#arrow-stealth-7c3aed)"></path></g><path d="M 179.358222 84.288496 A 40 40 0 0 1 210 70" stroke="#dc2626" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><path d="M 210 140 A 30 30 0 0 1 192.720802 134.524056" stroke="#7c3aed" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="186.333377" y="59.246764" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\theta_1$</text><text text-anchor="middle" dominant-baseline="middle" x="196.103299" y="153.850675" font-family="serif" font-size="12" font-style="italic" fill="#000">$\\theta_2$</text><text x="368" y="60" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">air</text><text x="356" y="195" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">water</text><text x="24" y="24" font-family="sans-serif" font-size="10" font-weight="normal" fill="#475569" text-anchor="start" dominant-baseline="middle">incidence: 50°  →  refraction: 35.2°</text></svg></div>"`;

exports[`examples > styled-badges 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="525.183" height="192" viewBox="23.216 21.25 525.183 192"><defs><filter id="jikz-shadow-2-3-5-7c3aed55" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur in="SourceAlpha" stdDeviation="5" result="blur"></feGaussianBlur><feOffset in="blur" dx="2" dy="3" result="offsetBlur"></feOffset><feFlood flood-color="#7c3aed55" flood-opacity="1" result="color"></feFlood><feComposite in="color" in2="offsetBlur" operator="in" result="shadow"></feComposite><feMerge><feMergeNode in="shadow"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter></defs><g><path d="M 41.216 47.25 L 78.784000 47.25 L 78.784000 72.75 L 41.216 72.75 Z" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="60" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#334155">plain</text></g><g><path d="M 162.317 47.25 L 197.683 47.25 A 12 12 0 0 1 209.683 59.25 L 209.683 60.75 A 12 12 0 0 1 197.683 72.75 L 162.317 72.75 A 12 12 0 0 1 150.317 60.75 L 150.317 59.25 A 12 12 0 0 1 162.317 47.25 Z" stroke="#2563eb" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="180" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#2563eb">rounded</text></g><g><path d="M 250.256 39.25 L 349.744 39.25 L 349.744 80.75 L 250.256 80.75 Z" stroke="#16a34a" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dcfce7" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="300" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#16a34a">innerSep 12</text></g><g><path d="M 402.094 47.25 L 457.906 47.25 A 8 8 0 0 1 465.906 55.25 L 465.906 64.75 A 8 8 0 0 1 457.906 72.75 L 402.094 72.75 A 8 8 0 0 1 394.094 64.75 L 394.094 55.25 A 8 8 0 0 1 402.094 47.25 Z" stroke="#7c3aed" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#ede9fe" fill-opacity="1" opacity="1" filter="url(#jikz-shadow-2-3-5-7c3aed55)"></path><text text-anchor="middle" dominant-baseline="middle" x="430" y="60" font-family="sans-serif" font-size="14" font-weight="normal" fill="#7c3aed">shadowed</text></g><g><path d="M 72.81 137.25 L 167.19 137.25 L 167.19 162.75 L 72.81 162.75 Z" stroke="#b45309" stroke-width="1.2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#fef3c7" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="120" y="150" font-family="sans-serif" font-size="14" font-weight="normal" fill="#b45309">double border</text></g><g><path d="M 261.756 137.25 L 338.244000 137.25 L 338.244000 162.75 L 261.756 162.75 Z" stroke="#dc2626" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#fee2e2" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="300" y="150" font-family="sans-serif" font-size="14" font-weight="normal" fill="#dc2626">outerSep 8</text></g><text x="300" y="119.625000" font-family="sans-serif" font-size="9" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">label gap = distance + outerSep</text><rect width="60" height="60" stroke="#0f172a" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f8fafc" fill-opacity="1" opacity="1" rx="14" ry="14" x="440" y="120"></rect><text x="470" y="189.625" font-family="sans-serif" font-size="9" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">bare rect + borderRadius style</text></svg>"`;

exports[`examples > styling 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="360" height="200" viewBox="0 0 360 200"><defs><linearGradient id="jikz-gradient-linear-a45-0-0ea5e9-1-a855f7" x1="14.64%" y1="85.36%" x2="85.36%" y2="14.64%"><stop offset="0.0%" stop-color="#0ea5e9"></stop><stop offset="100.0%" stop-color="#a855f7"></stop></linearGradient><filter id="jikz-shadow-3-3-4-000" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur in="SourceAlpha" stdDeviation="4" result="blur"></feGaussianBlur><feOffset in="blur" dx="3" dy="3" result="offsetBlur"></feOffset><feFlood flood-color="#000" flood-opacity="1" result="color"></feFlood><feComposite in="color" in2="offsetBlur" operator="in" result="shadow"></feComposite><feMerge><feMergeNode in="shadow"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter></defs><rect width="140" height="120" stroke="#111827" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="url(#jikz-gradient-linear-a45-0-0ea5e9-1-a855f7)" fill-opacity="1" opacity="1" x="30" y="40"></rect><circle r="55" stroke="#ca8a04" stroke-width="2" stroke-opacity="1" stroke-dasharray="3 3" stroke-linecap="round" stroke-linejoin="round" fill="#fde047" fill-opacity="1" opacity="1" filter="url(#jikz-shadow-3-3-4-000)" cx="260" cy="100"></circle></svg>"`;

