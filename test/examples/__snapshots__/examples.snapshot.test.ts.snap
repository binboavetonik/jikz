exports[`examples > venn 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="390" height="205" viewBox="0 0 390 205"><rect width="350" height="180" stroke="#94a3b8" stroke-width="1" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="none" fill-opacity="1" opacity="1" x="20" y="12"></rect><text x="36" y="30" font-family="sans-serif" font-size="11" font-weight="normal" fill="#000000" text-anchor="middle" dominant-baseline="middle">U</text><g><path d="M 70 102 A 80 80 0 1 0 230 102 A 80 80 0 1 0 70 102" stroke="#2563eb" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#2563eb" fill-opacity="0.25" opacity="1"></path></g><text text-anchor="middle" dominant-baseline="middle" x="83.7888168179569" y="35.78881681795692" font-family="serif" font-size="12" font-style="italic" fill="#000">$A$</text><g><path d="M 160 102 A 80 80 0 1 0 320 102 A 80 80 0 1 0 160 102" stroke="#dc2626" stroke-width="2" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#dc2626" fill-opacity="0.25" opacity="1"></path></g><text text-anchor="middle" dominant-baseline="middle" x="306.2111831820431" y="35.78881681795689" font-family="serif" font-size="12" font-style="italic" fill="#000">$B$</text><text text-anchor="middle" dominant-baseline="middle" x="195" y="102" font-family="serif" font-size="12" font-style="italic" fill="#000">$A \\cap B$</text></svg>"`;
