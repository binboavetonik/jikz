exports[`examples > tcp-states 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="500" height="320" viewBox="0 0 500 320"><defs><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-64748b" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#64748b"></path></marker><marker markerWidth="6" markerHeight="6" viewBox="0 0 10 10" id="arrow-stealth-2563eb" refX="9" refY="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 L 3 5 z" fill="#2563eb"></path></marker></defs><g><path d="M 52 110 A 38 38 0 1 0 128 110 A 38 38 0 1 0 52 110" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="90" y="110" font-family="sans-serif" font-size="11" font-weight="normal" fill="#334155">CLOSED</text></g><g><path d="M 207 60 A 43 43 0 1 0 293 60 A 43 43 0 1 0 207 60" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="250" y="60" font-family="sans-serif" font-size="11" font-weight="normal" fill="#334155">SYN SENT</text></g><g><path d="M 354 120 A 56 56 0 1 0 466 120 A 56 56 0 1 0 354 120" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="410" y="120" font-family="sans-serif" font-size="10" font-weight="normal" fill="#334155">ESTABLISHED</text></g><g><path d="M 207 200 A 43 43 0 1 0 293 200 A 43 43 0 1 0 207 200" stroke="#334155" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round" stroke-linejoin="round" fill="#f1f5f9" fill-opacity="1" opacity="1"></path><text text-anchor="middle" dominant-baseline="middle" x="250" y="200" font-family="sans-serif" font-size="11" font-w